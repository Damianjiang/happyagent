<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingLeft="12dp"
    android:paddingRight="12dp"
    android:paddingTop="3dp"
    android:paddingBottom="3dp">

    <!-- 用户消息：靠右品牌色气泡 -->
    <LinearLayout
        android:id="@+id/row_user"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end"
            android:layout_marginEnd="24dp">

            <!-- 用户附件：图片缩略图 + 文件 chip -->
            <LinearLayout
                android:id="@+id/user_attachments"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end"
                android:visibility="gone" />

            <TextView
                android:id="@+id/bubble_user"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_bubble_user"
                android:maxWidth="300dp"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:textSize="14sp"
                android:lineSpacingExtra="3dp"
                android:textColor="?attr/colorOnPrimary" />
        </LinearLayout>
    </LinearLayout>

    <!-- AI 消息：靠左，小头像 + 纯文本 -->
    <LinearLayout
        android:id="@+id/row_ai"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="top"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_avatar_ai">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="✦"
                android:textSize="13sp"
                android:includeFontPadding="false"
                android:textColor="?attr/colorPrimary" />
        </FrameLayout>

        <TextView
            android:id="@+id/bubble_ai"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:layout_marginLeft="10dp"
            android:paddingTop="2dp"
            android:paddingRight="8dp"
            android:layout_marginEnd="8dp"
            android:textSize="14sp"
            android:lineSpacingExtra="3dp"
            android:textColor="?attr/colorOnSurface" />

        <ImageView
            android:id="@+id/bubble_ai_copy"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="top"
            android:layout_marginTop="2dp"
            android:padding="3dp"
            android:src="@drawable/ic_copy"
            android:contentDescription="复制回复"
            app:tint="?attr/colorOnSurfaceVariant"
            android:background="?android:attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <!-- 工具调用：居中小灰等宽字 -->
    <LinearLayout
        android:id="@+id/row_tool"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingLeft="32dp"
        android:paddingRight="32dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/bubble_tool"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_bubble_tool"
                android:fontFamily="monospace"
                android:paddingLeft="10dp"
                android:paddingRight="6dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:textSize="11sp"
                android:maxWidth="260dp"
                android:lineSpacingExtra="2dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <ImageView
                android:id="@+id/bubble_tool_expand"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:padding="3dp"
                android:layout_marginStart="2dp"
                android:src="@drawable/ic_chevron"
                android:contentDescription="展开工具输出"
                app:tint="?attr/colorOnSurfaceVariant"
                android:background="?android:attr/selectableItemBackgroundBorderless" />

            <ImageView
                android:id="@+id/bubble_tool_copy"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:padding="2dp"
                android:layout_marginStart="2dp"
                android:src="@drawable/ic_copy"
                android:contentDescription="复制工具输出"
                app:tint="?attr/colorOnSurfaceVariant"
                android:background="?android:attr/selectableItemBackgroundBorderless" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
