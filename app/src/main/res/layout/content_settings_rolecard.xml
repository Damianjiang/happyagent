<?xml version="1.0" encoding="utf-8"?>
<!-- 角色卡：独立一页（角色名 + 角色设定 + 预设 + AI 生成 + 保存），改完即注入系统提示词 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="角色卡 / 人设"
        style="@style/SectionHeader" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeColor="?attr/colorOutlineVariant"
        app:strokeWidth="1dp"
        app:cardBackgroundColor="?attr/colorSurface">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="角色名与设定会注入每次任务的系统提示词（留空则用默认助手人格）"
                android:textSize="12sp"
                android:lineSpacingExtra="2dp"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <EditText
                android:id="@+id/set_role_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_input"
                android:inputType="text"
                android:hint="角色名（如：小助 / 严谨工手）"
                android:padding="12dp"
                android:singleLine="true"
                android:textSize="13sp"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?attr/colorOnSurfaceVariant" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="角色设定（世界书 · 注入给 AI）"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="性格、口吻、价值观、说话规则…写多少 AI 就照多少；留空=默认"
                android:textSize="11sp"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <EditText
                android:id="@+id/set_role_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:hint="例如：你叫小助，说话简短直接，先结论后细节，偏好中文，技术话题给可运行代码。"
                android:padding="12dp"
                android:textSize="13sp"
                android:lines="6"
                android:minLines="6"
                android:scrollbars="vertical"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?attr/colorOnSurfaceVariant" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="预设风格（点一下填入上面两项，可再改）"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/set_role_presets"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/set_role_save"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="保存角色卡"
                style="@style/Widget.App.Button" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/set_role_ai"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="AI 生成角色卡"
                style="@style/Widget.App.Button.Tonal" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/set_role_clear"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="清空（恢复默认人格）"
                style="@style/Widget.App.Button.Outline" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
