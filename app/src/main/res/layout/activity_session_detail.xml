<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:colorBackground">

    <!-- 顶栏：品牌渐变，白字 -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/detail_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@drawable/bg_toolbar_gradient"
        app:navigationIcon="@drawable/ic_close"
        app:titleTextColor="@android:color/white"
        app:title="对话" />

    <!-- 状态条：模型 + 状态徽章 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:background="?attr/colorSurface">

        <TextView
            android:id="@+id/detail_model"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:text="模型: -" />

        <TextView
            android:id="@+id/detail_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/StatusBadge" />
    </LinearLayout>

    <!-- 消息流 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/chat_recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        android:paddingBottom="8dp" />

    <!-- 空对话提示 -->
    <TextView
        android:id="@+id/chat_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="24dp"
        android:textSize="14sp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:text="开始和我对话吧。右下角输入消息，点发送。" />

    <!-- 底部输入条 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="10dp"
        android:background="?attr/colorSurface">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:background="@drawable/bg_input_bar">

            <EditText
                android:id="@+id/detail_prompt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:hint="说点什么…"
                android:inputType="textMultiLine"
                android:maxLines="4"
                android:minLines="1"
                android:paddingLeft="14dp"
                android:paddingRight="6dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:textSize="14sp"
                android:textColor="?attr/colorOnSurface" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/detail_send"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_send_btn"
            android:src="@drawable/ic_send"
            android:contentDescription="发送"
            android:scaleType="center" />
    </LinearLayout>

</LinearLayout>
