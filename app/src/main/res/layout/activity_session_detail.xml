<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:colorBackground">

    <!-- 顶栏：主题表面色 + 主题文字，副标题显示当前模型；深浅两套都跟主题走 -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/detail_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface"
        app:navigationIcon="@drawable/ic_close"
        app:titleTextColor="?attr/colorOnSurface"
        app:subtitleTextColor="?attr/colorOnSurfaceVariant"
        app:title="对话" />

    <!-- 本会话工作区：每个对话各占一个沙箱；可导外部目录进来（真拷贝，SAF 拿不到裸 File） -->
    <LinearLayout
        android:id="@+id/detail_workspace_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="?attr/colorSurface"
        android:baselineAligned="false">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="本会话工作区"
            android:textSize="12sp"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/detail_workspace_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginLeft="8dp"
            android:ellipsize="middle"
            android:singleLine="true"
            android:text="内置沙箱"
            android:textSize="12sp"
            android:textColor="?attr/colorOnSurface" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/detail_workspace_pick"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:text="选外部目录"
            android:textSize="12sp"
            style="@style/Widget.App.Button.Outline" />
    </LinearLayout>

    <!-- 消息流 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/chat_recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="10dp"
        android:paddingBottom="6dp"
        android:background="?android:colorBackground" />

    <!-- 空对话提示：居中一行主标题 + 一行次级说明，克制不堆砌 -->
    <LinearLayout
        android:id="@+id/chat_empty_wrap"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✦"
            android:textSize="28sp"
            android:includeFontPadding="false"
            android:gravity="center"
            android:textColor="?attr/colorPrimary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="有什么要我做的？"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="描述任务，或点下方 图片 / 文件 / 麦克风 附上材料"
            android:textSize="13sp"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <!-- 任务控制条：醒目运行状态行 + 暂停 / 继续 / 取消，任务运行时才出现 -->
    <LinearLayout
        android:id="@+id/detail_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="6dp"
        android:background="?attr/colorSurface">

        <!-- 运行状态行：彩色点 + 加粗状态文字，让「正在跑/已暂停」一眼可见 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/detail_run_dot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="●"
                android:textSize="11sp"
                android:textColor="@color/status_done" />

            <TextView
                android:id="@+id/detail_run_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:layout_marginLeft="6dp"
                android:text="运行中"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/detail_pause"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:layout_marginRight="6dp"
            android:text="暂停"
            style="@style/Widget.App.Button.Tonal" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/detail_resume"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="6dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_marginRight="6dp"
            android:text="继续"
            android:visibility="gone"
            style="@style/Widget.App.Button.Tonal" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/detail_cancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="6dp"
            android:layout_marginStart="6dp"
            android:text="取消"
            style="@style/Widget.App.Button.Outline" />
        </LinearLayout>
    </LinearLayout>

    <!-- 重新生成：任务结束后显示，点一下重跑最后一条用户消息 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/detail_regen"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:text="重新生成"
        android:textSize="12sp"
        android:visibility="gone"
        style="@style/Widget.App.Button.Text" />

    <!-- 待发送附件预览行：选了图片/文件后显示，点 × 移除 -->
    <HorizontalScrollView
        android:id="@+id/detail_attach_strip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="8dp"
        android:scrollbars="none"
        android:background="?attr/colorSurface">

        <LinearLayout
            android:id="@+id/attach_strip_items"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- 底部输入：一个圆角容器 = [图片][文件] [输入框...] [发送] -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="?attr/colorSurface"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_input_bar"
            android:paddingLeft="6dp"
            android:paddingRight="4dp">

            <ImageButton
                android:id="@+id/detail_pick_image"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_image"
                android:contentDescription="选择图片"
                android:scaleType="center"
                app:tint="?attr/colorOnSurfaceVariant" />

            <ImageButton
                android:id="@+id/detail_pick_file"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginLeft="2dp"
                android:layout_marginStart="2dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_file"
                android:contentDescription="选择文件"
                android:scaleType="center"
                app:tint="?attr/colorOnSurfaceVariant" />

            <ImageButton
                android:id="@+id/detail_mic"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginLeft="2dp"
                android:layout_marginStart="2dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_mic"
                android:contentDescription="语音输入"
                android:scaleType="center"
                app:tint="?attr/colorOnSurfaceVariant" />

            <EditText
                android:id="@+id/detail_prompt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:hint="说点什么…"
                android:inputType="textMultiLine"
                android:maxLines="4"
                android:minLines="1"
                android:paddingLeft="8dp"
                android:paddingRight="4dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:gravity="top"
                android:textSize="14sp"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?attr/colorOnSurfaceVariant" />

            <ImageButton
                android:id="@+id/detail_send"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_send_btn"
                android:src="@drawable/ic_send"
                android:contentDescription="发送"
                android:scaleType="center"
                app:tint="@android:color/white" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
