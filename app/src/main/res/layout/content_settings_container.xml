<?xml version="1.0" encoding="utf-8"?>
<!-- 容器环境：proot + Alpine 一键部署 / 进度 / 终端 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="容器环境"
        style="@style/SectionHeader" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeColor="?attr/colorOutlineVariant"
        app:strokeWidth="1dp"
        app:cardBackgroundColor="?attr/colorSurface">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="免 root Linux 容器（proot + Alpine）"
                android:textSize="15sp"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="运行时下载部署（不进 APK，包体保持小）；支持多线程 + 断点续传 + 国内镜像"
                android:textSize="12sp"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/set_proot_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_status_pill"
                android:text="未部署"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/status_failed" />

            <ProgressBar
                android:id="@+id/set_proot_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:visibility="gone"
                style="?android:attr/progressBarStyleHorizontal" />

            <TextView
                android:id="@+id/set_proot_progress_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:visibility="gone"
                android:textSize="11sp"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/set_proot_deploy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="一键部署"
                style="@style/Widget.App.Button" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/set_proot_cancel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:visibility="gone"
                android:text="取消部署"
                style="@style/Widget.App.Button.Outline" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="部署后可在对话里让 agent 用 shell_proot 跑 Python / 装包 / 编译等容器命令"
                android:textSize="11sp"
                android:lineSpacingExtra="2dp"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/set_proot_terminal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="进入容器终端"
                style="@style/Widget.App.Button.Outline" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
