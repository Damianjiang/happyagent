    <color name="acc_teal">#4FD1C5</color>
    <color name="acc_moss">#9CC35A</color>
    <color name="acc_rust">#F16A8B</color>
    <color name="acc_amber">#F0A34A</color>
    <!-- 亮强调色上的文字用墨色而不是白 -->
