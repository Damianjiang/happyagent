    <!-- 墨色基底 -->
    <color name="background">#0E0E11</color>
    <color name="surface">#17171C</color>
    <color name="surface_variant">#202027</color>
    <color name="on_surface">#EDEDEF</color>
    <color name="on_surface_variant">#A2A2AC</color>
    <color name="outline">#2C2C34</color>
    <color name="hairline">#222228</color>

    <!-- 状态色：暗色提亮版 -->
