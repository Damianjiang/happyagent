<?xml version="1.0" encoding="utf-8"?>
<!-- 极简紫灰：少废话，留白多，发丝线分层不用阴影 -->
<resources>
    <style name="AppTheme" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/acc_default</item>
        <item name="colorOnPrimary">@color/acc_on</item>
        <item name="colorPrimaryContainer">@color/acc_default_c</item>
        <item name="colorOnPrimaryContainer">@color/acc_default_c_on</item>
        <item name="colorSecondary">@color/acc_default</item>
        <item name="colorOnSecondary">@color/acc_on</item>
        <item name="colorSecondaryContainer">@color/acc_default_c</item>
        <item name="colorOnSecondaryContainer">@color/acc_default_c_on</item>

        <item name="android:colorBackground">@color/background</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/hairline</item>
        <item name="colorError">@color/error</item>
        <item name="colorOnError">#FFFFFF</item>

        <item name="android:statusBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/background</item>

        <item name="materialButtonStyle">@style/Widget.App.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.App.Button.Outline</item>
    </style>

    <style name="AppTheme.Teal" parent="AppTheme">
        <item name="colorPrimary">@color/acc_teal</item>
        <item name="colorPrimaryContainer">@color/acc_teal_c</item>
        <item name="colorOnPrimaryContainer">@color/acc_teal_c_on</item>
        <item name="colorSecondary">@color/acc_teal</item>
        <item name="colorSecondaryContainer">@color/acc_teal_c</item>
        <item name="colorOnSecondaryContainer">@color/acc_teal_c_on</item>
    </style>

    <style name="AppTheme.Moss" parent="AppTheme">
        <item name="colorPrimary">@color/acc_moss</item>
        <item name="colorPrimaryContainer">@color/acc_moss_c</item>
        <item name="colorOnPrimaryContainer">@color/acc_moss_c_on</item>
        <item name="colorSecondary">@color/acc_moss</item>
        <item name="colorSecondaryContainer">@color/acc_moss_c</item>
        <item name="colorOnSecondaryContainer">@color/acc_moss_c_on</item>
    </style>

    <style name="AppTheme.Rust" parent="AppTheme">
        <item name="colorPrimary">@color/acc_rust</item>
        <item name="colorPrimaryContainer">@color/acc_rust_c</item>
        <item name="colorOnPrimaryContainer">@color/acc_rust_c_on</item>
        <item name="colorSecondary">@color/acc_rust</item>
        <item name="colorSecondaryContainer">@color/acc_rust_c</item>
        <item name="colorOnSecondaryContainer">@color/acc_rust_c_on</item>
    </style>

    <style name="AppTheme.Amber" parent="AppTheme">
        <item name="colorPrimary">@color/acc_amber</item>
        <item name="colorPrimaryContainer">@color/acc_amber_c</item>
        <item name="colorOnPrimaryContainer">@color/acc_amber_c_on</item>
        <item name="colorSecondary">@color/acc_amber</item>
        <item name="colorSecondaryContainer">@color/acc_amber_c</item>
        <item name="colorOnSecondaryContainer">@color/acc_amber_c_on</item>
    </style>

    <!-- 灰色背景选项：中性灰 -->
    <style name="AppTheme.GrayBg" parent="AppTheme">
        <item name="android:colorBackground">#E8E8E8</item>
        <item name="android:windowBackground">#E8E8E8</item>
        <item name="colorSurface">#F5F5F5</item>
        <item name="android:statusBarColor">#E8E8E8</item>
        <item name="android:navigationBarColor">#E8E8E8</item>
    </style>

    <!-- 按钮：10dp 圆角，不花哨 -->
    <style name="Widget.App.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">10dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.App.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="cornerRadius">10dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.App.Button.Outline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">10dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.App.Button.Seg" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">10dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.App.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="cornerRadius">10dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="rippleColor">?attr/colorOutlineVariant</item>
    </style>

    <!-- 卡片：12dp 圆角，发丝边框，无阴影 -->
    <style name="CardStyle">
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0.5dp</item>
        <item name="strokeColor">?attr/colorOutline</item>
    </style>

    <style name="SectionHeader">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <style name="StatusBadge">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">11sp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:gravity">center</item>
        <item name="android:minWidth">48dp</item>
    </style>
</resources>
