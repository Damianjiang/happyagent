<?xml version="1.0" encoding="utf-8"?>
<!-- 浅色：纸感。暖白底 + 墨色文字 + 单一强调色，卡片走发丝边框不吃阴影 -->
<resources>
    <!-- 强调色 5 选 1（values-night 给暗色用提亮版） -->
    <color name="acc_default">#4B7BF5</color>
    <color name="acc_teal">#0F766E</color>
    <color name="acc_moss">#4D7C0F</color>
    <color name="acc_rust">#BE123C</color>
    <color name="acc_amber">#B45309</color>
    <color name="acc_on">#FFFFFF</color>

    <!-- 纸面基底 -->
    <color name="background">#F6F5F2</color>
    <color name="surface">#FFFFFF</color>
    <color name="surface_variant">#F0EFEB</color>
    <color name="on_surface">#1B1B1B</color>
    <color name="on_surface_variant">#575652</color>
    <color name="outline">#E5E3DD</color>
    <color name="hairline">#ECEAE4</color>

    <!-- 状态色：running 跟随强调色（drawable 里写 ?attr/colorPrimary），成败用固定语义色 -->
    <color name="status_done">#3F8135</color>
    <color name="status_failed">#C2373B</color>
    <color name="status_paused">#B45309</color>
    <color name="error">#C2373B</color>

    <color name="on_primary">#FFFFFF</color>

    <!-- 强调色容器（浅色）：Tonal 按钮/选中控件的底 -->
    <color name="acc_default_c">#E7EDFD</color>
    <color name="acc_default_c_on">#14284B</color>
    <color name="acc_teal_c">#D9EDEA</color>
    <color name="acc_teal_c_on">#0B3B36</color>
    <color name="acc_moss_c">#E7EFDA</color>
    <color name="acc_moss_c_on">#2A4208</color>
    <color name="acc_rust_c">#F9DEE3</color>
    <color name="acc_rust_c_on">#4A0A18</color>
    <color name="acc_amber_c">#F5E7D3</color>
    <color name="acc_amber_c_on">#4A2B08</color>
</resources>
